@model ComprarTicketViewModel
@{
    ViewData["Title"] = "Comprar Ticket";
}
<section class="hero-ticket">
    <div class="hero-overlay"></div>
    <div class="hero-copy">
        <h1>Compra tu Ticket</h1>
        <p>Ingreso al estacionamiento de Plaza Génesis</p>
    </div>
</section>

<section class="purchase-shell">
    <form asp-action="Comprar" method="post" id="ticketForm" class="purchase-form">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <section class="step-card">
            <div class="step-heading">
                <span class="step-number">1</span>
                <div><h2>Información del vehículo</h2><p>Ingrese la placa y seleccione el tipo de vehículo</p></div>
            </div>
            <label asp-for="Placa" class="field-label"></label>
            <div class="input-with-icon"><span>▰</span><input asp-for="Placa" id="plateInput" placeholder="Ej. PDH1234" autocomplete="off" /></div>
            <span asp-validation-for="Placa" class="validation"></span>

            <label class="field-label">Tipo de vehículo</label>
            <input asp-for="TipoVehiculo" id="vehicleType" type="hidden" />
            <div class="vehicle-grid" role="radiogroup" aria-label="Tipo de vehículo">
                <button type="button" class="vehicle-option selected" data-type="Automóvil" data-price="20"><span class="vehicle-icon">🚗</span><span>Automóvil</span><strong>L 20.00</strong></button>
                <button type="button" class="vehicle-option" data-type="Motocicleta" data-price="10"><span class="vehicle-icon">🏍</span><span>Motocicleta</span><strong>L 10.00</strong></button>
                <button type="button" class="vehicle-option" data-type="Pickup" data-price="30"><span class="vehicle-icon">🛻</span><span>Pickup</span><strong>L 30.00</strong></button>
                <button type="button" class="vehicle-option" data-type="Camión" data-price="50"><span class="vehicle-icon">🚚</span><span>Camión</span><strong>L 50.00</strong></button>
            </div>
        </section>

        <section class="step-card payment-card">
            <div class="step-heading">
                <span class="step-number">2</span>
                <div><h2>Método de pago</h2><p>Seleccione la forma de pago (simulada)</p></div>
            </div>
            <input asp-for="FormaPago" id="paymentMethod" type="hidden" />
            <div class="payment-grid">
                <button type="button" class="payment-option selected" data-payment="Tarjeta de crédito/débito"><span>▣</span>Tarjeta de crédito/débito</button>
                <button type="button" class="payment-option" data-payment="Efectivo"><span>●</span>Efectivo</button>
                <button type="button" class="payment-option" data-payment="Transferencia"><span>▯</span>Transferencia</button>
            </div>
            <div id="cardFields" class="card-fields">
                <label>Número de tarjeta<input inputmode="numeric" placeholder="1234 5678 9012 3456" /></label>
                <label>Fecha de expiración<input placeholder="MM/AA" /></label>
                <label>CVV<input inputmode="numeric" maxlength="4" placeholder="123" /></label>
            </div>
            <p class="simulation-note">Demostración académica: no se procesa dinero real.</p>
            <button class="generate-btn" type="submit"><span>▣</span> Generar Ticket <b>›</b></button>
        </section>
    </form>

    <aside class="summary-card">
        <div class="step-heading">
            <span class="step-number">3</span>
            <div><h2>Resumen del ticket</h2><p>Verifique la información antes de generar el ticket</p></div>
        </div>
        <img class="summary-image" src="~/images/plaza-summary.jpg" alt="Plaza Génesis" />
        <dl class="summary-list">
            <div><dt>Placa:</dt><dd id="summaryPlate">—</dd></div>
            <div><dt>Tipo de vehículo:</dt><dd id="summaryType">Automóvil</dd></div>
            <div><dt>Tarifa:</dt><dd id="summaryPrice" class="blue-text">L 20.00</dd></div>
            <div><dt>Plaza:</dt><dd>Plaza Génesis</dd></div>
            <div><dt>Ubicación:</dt><dd>Sonaguera, Colón</dd></div>
            <div><dt>Fecha y hora:</dt><dd id="summaryDate">—</dd></div>
        </dl>
        <div class="summary-info"><span>ⓘ</span><p>El ticket generado le servirá para la entrada y salida del estacionamiento. Guarde su código.</p></div>
    </aside>
</section>
