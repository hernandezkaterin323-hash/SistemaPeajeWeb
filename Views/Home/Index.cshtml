@{
    ViewData["Title"] = "Inicio";
}
<section class="hero-ticket home-hero">
    <div class="hero-overlay"></div>
    <div class="hero-copy"><h1>Plaza Génesis</h1><p>Sistema inteligente de control de estacionamiento · Sonaguera, Colón</p><a class="hero-button" asp-controller="Peaje" asp-action="Comprar">Comprar ticket</a></div>
</section>
<section class="home-grid">
    <article class="step-card"><span class="step-number">1</span><h2>Compre el ticket</h2><p>Registre la placa, elija el vehículo y simule el pago.</p></article>
    <article class="step-card"><span class="step-number">2</span><h2>Valide la entrada</h2><p>El código autoriza la apertura de la barrera de entrada.</p></article>
    <article class="step-card"><span class="step-number">3</span><h2>Valide la salida</h2><p>El mismo ticket completa el ciclo cuando el vehículo sale.</p></article>
</section>
